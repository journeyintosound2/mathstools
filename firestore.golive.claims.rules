rules_version = '2';

// Mills Maths Tools — PRODUCTION claim-based rules (Phase 4A go-live + classes +
// dashboard tasks + ADMIN CONSOLE 2026-07 + MMT SCREEN saved boards 2026-09-13
// + MMT SCREEN class lists 2026-09-15 + EMAIL LOG 2026-10-24).
//
// Every STUDENT/TEACHER client signs in via the secure code-exchange Cloud
// Functions (exchangeStudentCode / exchangeTeacherCode), which mint a Firebase
// Auth custom token carrying { role, studentCode | teacherCode, className }.
// These rules scope all reads/writes to the signed-in owner. Student/teacher
// identity + all teacher-set collections are written server-side (Admin SDK) only.
//
// The ADMIN CONSOLE (portal/admin/) is the one exception: a single admin signs in
// with a real Firebase Auth email+password account and manages identity directly.
// Admin writes are allowed ONLY for the exact admin UID below — no shared secret,
// no anonymous writes. Everyone else is still default-deny.
// Deploy by pasting into Firebase Console → Firestore → Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function authed()    { return request.auth != null; }
    function role()      { return authed() ? request.auth.token.role : ''; }
    function isStudent() { return role() == 'student'; }
    function isTeacher() { return role() == 'teacher'; }
    function myStudent() { return request.auth.token.studentCode; }
    function myTeacher() { return request.auth.token.teacherCode; }

    // ---- ADMIN ----
    // The admin console signs in with a normal Firebase Auth account (email +
    // password). Paste that account's User UID below (Firebase Console →
    // Authentication → Users → copy the UID). Only this UID can manage identity.
    // (You can list several UIDs in the array if you ever add a second admin.)
    function isAdmin() {
      return authed() && request.auth.uid in [
        'FQjmfFBvYrYPHljdX5pHfaYcdG82'
      ];
    }

    // Students: a student reads only their own doc; a teacher reads only their
    // own class (query must filter by teacherCode == claim). The admin reads,
    // lists and writes any student. No other client writes.
    match /students/{studentCode} {
      allow read: if isAdmin()
                  || (isStudent() && myStudent() == studentCode)
                  || (isTeacher() && resource.data.teacherCode == myTeacher());
      allow create, update, delete: if isAdmin();
    }

    // Teachers: a teacher reads only their own doc. The admin reads, lists and
    // writes any teacher. No other client writes, no other listing.
    match /teachers/{teacherCode} {
      allow get: if isAdmin() || (isTeacher() && myTeacher() == teacherCode);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Achievements: a student reads only their own; a teacher reads only their
    // class. Create-only, and ONLY for the signed-in student's own studentCode.
    // Never edited or deleted from the client. (Admin does not need these.)
    match /achievements/{id} {
      allow read: if isAdmin()
                  || (isStudent() && resource.data.studentCode == myStudent())
                  || (isTeacher() && resource.data.teacherCode == myTeacher());
      allow create: if isStudent() && request.resource.data.studentCode == myStudent();
      allow update, delete: if false;
    }

    // Adventure attempts: same owner-scoped reads. Create-only for the signed-in
    // student, tagged from the Adventure. Never edited or deleted.
    match /adventureAttempts/{id} {
      allow read: if (isStudent() && resource.data.studentCode == myStudent())
                  || (isTeacher() && resource.data.teacherCode == myTeacher());
      allow create: if isStudent()
        && request.resource.data.studentCode == myStudent()
        && request.resource.data.source == 'mills-maths-adventure';
      allow update, delete: if false;
    }

    // Adventure assignments (teacher-set Adventure tasks): a teacher reads their
    // own class's tasks; a student reads ACTIVE tasks for their own class. Writes
    // go through the createAdventureTask / updateAdventureTask /
    // setAdventureTaskActive Functions only (Admin SDK). The student query MUST
    // filter by teacherCode + className + active to satisfy this rule.
    match /adventureAssignments/{id} {
      allow read: if (isTeacher() && resource.data.teacherCode == myTeacher())
                  || (isStudent()
                      && resource.data.teacherCode == request.auth.token.teacherCode
                      && resource.data.className  == request.auth.token.className
                      && resource.data.active == true);
      allow create, update, delete: if false;
    }

    // Dashboard assignments (teacher-set online-quiz tasks): same shape as
    // adventure assignments. A teacher reads their own; a student reads ACTIVE
    // tasks for their own class. Writes go through the createDashboardTask /
    // updateDashboardTask / setDashboardTaskActive Functions only (Admin SDK).
    match /dashboardAssignments/{id} {
      allow read: if (isTeacher() && resource.data.teacherCode == myTeacher())
                  || (isStudent()
                      && resource.data.teacherCode == request.auth.token.teacherCode
                      && resource.data.className  == request.auth.token.className
                      && resource.data.active == true);
      allow create, update, delete: if false;
    }

    // Classes: a teacher reads/lists only their own (a query MUST filter by
    // teacherCode == claim). The admin reads, lists and writes any class.
    // Written server-side by createClass / setClassActive (Admin SDK) for
    // teachers, or directly by the admin console. Students never read this.
    match /classes/{classId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherCode == myTeacher());
      allow create, update, delete: if isAdmin();
    }

    // MMT Screen saved boards (2026-09-13): a teacher saves a classroom screen
    // layout and opens it on any computer. Unlike classes / assignments these
    // are written DIRECTLY BY THE CLIENT, because a screen is the teacher's own
    // furniture — not identity and not student results, which is what the
    // server-side-only rule protects. The teacherCode claim is minted by
    // exchangeTeacherCode and cannot be forged, so these checks do the scoping:
    // create demands the new doc carry the caller's own teacherCode AND the doc
    // id start with it (nobody can write into another teacher's id space);
    // update demands BOTH the existing and the incoming doc be theirs (or a
    // teacher could hand a screen to someone else's code); delete has no
    // request.resource so it checks the existing doc only. A query MUST filter
    // by teacherCode == claim, exactly as for classes. Screens can contain a
    // class list in the name-picker widget — the same first-name data the
    // platform already holds, and a choice the teacher makes per screen.
    match /screens/{screenId} {
      allow read:   if isAdmin() || (isTeacher() && resource.data.teacherCode == myTeacher());
      allow create: if isAdmin() || (isTeacher()
                       && request.resource.data.teacherCode == myTeacher()
                       && screenId.matches('^' + myTeacher() + '__.*'));
      allow update: if isAdmin() || (isTeacher()
                       && resource.data.teacherCode == myTeacher()
                       && request.resource.data.teacherCode == myTeacher());
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherCode == myTeacher());
    }

    // MMT Screen class lists (2026-09-15): the teacher's own class rolls, so the
    // group maker and the name picker have the same classes on every computer
    // they sign in on. ONE DOCUMENT PER TEACHER, KEYED BY THE TEACHER CODE —
    // the document id IS the thing being scoped, which makes this the tightest
    // rule in the file: there is no way to address another teacher's document
    // without failing the id check. A teacher reads and writes only their own;
    // there is no listing, because nothing needs to enumerate them.
    //
    // These hold student FIRST NAMES, the same ones the platform already holds
    // for the student portal, and only the ones a teacher typed in deliberately.
    // Note they were already travelling inside any saved screen that had a
    // group maker or name picker on it; this stores them once, on purpose,
    // instead of copied into every board.
    match /teacherLists/{teacherCode} {
      allow get:    if isAdmin() || (isTeacher() && myTeacher() == teacherCode);
      allow list:   if isAdmin();
      allow create, update: if isAdmin() || (isTeacher()
                       && myTeacher() == teacherCode
                       && request.resource.data.teacherCode == myTeacher());
      allow delete: if isAdmin() || (isTeacher() && myTeacher() == teacherCode);
    }

    // Email log (2026-10-24): one doc per email sent from the admin console's
    // Email page. Written ONLY by the sendAdminEmail Cloud Function (Admin SDK);
    // the admin reads it to show "Sent emails". Holds teacher names + addresses,
    // so nobody else can read it. (Teacher profile edits need no rule change:
    // they go through the updateMyTeacherProfile function, and the admin
    // console already has write access to teachers/{code}.)
    match /emailLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin settings (capacity caps etc.): admin-only, read + write. Nobody else
    // can see or touch it.
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    // Everything else — including identity writes and any other collection
    // (e.g. best-effort platform-progress writes) — is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
